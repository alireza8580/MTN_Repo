#!/bin/bash
#===============================================================================
# EREFILL Gather Stats - Schedule C (Every 12 hours)
# Server: Drl167
# PDBs: EREFILL_EVENT, EREFILL_CORE
# 
# Part 1: Dynamic partition stats (active partitions only)
# Part 2: Static non-partitioned tables (full table stats)
#
# Cron: 0 11,23 * * *
#===============================================================================

# Source configuration
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source ${SCRIPT_DIR}/erefill_config.env

# Cleanup logs older than 30 days
cleanup_old_logs

# Combined log for email
COMBINED_LOG="${LOG_DIR}/scheduleC.log"

log_message "Schedule C Started"
START_TIME=$(date +%s)
FAILED_PARTS=""

# Clear combined log
> "$COMBINED_LOG"

#------------------------------------------------------------------------------
# Part 1: EREFILL_EVENT PDB - Dynamic partition stats
#------------------------------------------------------------------------------
echo "=== EREFILL_EVENT PDB - Dynamic Partitions ===" >> "$COMBINED_LOG"
export ORACLE_PDB_SID=${PDB_EREFILL_EVENT}
${ORACLE_HOME}/bin/sqlplus -S / as sysdba @${SCRIPT_DIR}/erefill_scheduleC_gen_event.sql $SCRIPT_DIR 2>&1 | tee -a ${COMBINED_LOG}
SQL_STATUS1=${PIPESTATUS[0]}

if [ $SQL_STATUS1 -ne 0 ]; then
    log_message "Schedule C (EVENT Dynamic) FAILED"
    FAILED_PARTS+="EVENT_DYN "
fi

#------------------------------------------------------------------------------
# Part 2: EREFILL_EVENT PDB - Static non-partitioned tables
#------------------------------------------------------------------------------
echo "" >> "$COMBINED_LOG"
echo "=== EREFILL_EVENT PDB - Static Tables ===" >> "$COMBINED_LOG"
export ORACLE_PDB_SID=${PDB_EREFILL_EVENT}
${ORACLE_HOME}/bin/sqlplus -S / as sysdba @${SCRIPT_DIR}/erefill_scheduleC_static_event.sql 2>&1 | tee -a ${COMBINED_LOG}
SQL_STATUS2=${PIPESTATUS[0]}

if [ $SQL_STATUS2 -ne 0 ]; then
    log_message "Schedule C (EVENT Static) FAILED"
    FAILED_PARTS+="EVENT_STATIC "
fi

#------------------------------------------------------------------------------
# Part 3: EREFILL_CORE PDB - Dynamic partition stats
#------------------------------------------------------------------------------
echo "" >> "$COMBINED_LOG"
echo "=== EREFILL_CORE PDB - Dynamic Partitions ===" >> "$COMBINED_LOG"
export ORACLE_PDB_SID=${PDB_EREFILL_CORE}
${ORACLE_HOME}/bin/sqlplus -S / as sysdba @${SCRIPT_DIR}/erefill_scheduleC_gen_core.sql $SCRIPT_DIR 2>&1 | tee -a ${COMBINED_LOG}
SQL_STATUS3=${PIPESTATUS[0]}

if [ $SQL_STATUS3 -ne 0 ]; then
    log_message "Schedule C (CORE Dynamic) FAILED"
    FAILED_PARTS+="CORE_DYN "
fi

#------------------------------------------------------------------------------
# Part 4: EREFILL_CORE PDB - Static non-partitioned tables
#------------------------------------------------------------------------------
echo "" >> "$COMBINED_LOG"
echo "=== EREFILL_CORE PDB - Static Tables ===" >> "$COMBINED_LOG"
export ORACLE_PDB_SID=${PDB_EREFILL_CORE}
${ORACLE_HOME}/bin/sqlplus -S / as sysdba @${SCRIPT_DIR}/erefill_scheduleC_static_core.sql 2>&1 | tee -a ${COMBINED_LOG}
SQL_STATUS4=${PIPESTATUS[0]}

if [ $SQL_STATUS4 -ne 0 ]; then
    log_message "Schedule C (CORE Static) FAILED"
    FAILED_PARTS+="CORE_STATIC "
fi

END_TIME=$(date +%s)
ELAPSED=$((END_TIME - START_TIME))

if [ -z "$FAILED_PARTS" ]; then
    log_message "Schedule C Completed Successfully (Elapsed: $(format_duration $ELAPSED))"
    send_success_email "Schedule C (22 tables)" "$COMBINED_LOG" "EREFILL"
else
    log_message "Schedule C FAILED ($FAILED_PARTS)"
    send_email "Schedule C FAILED ($FAILED_PARTS)" "Gather stats failed at $(date)\nElapsed: $(format_duration $ELAPSED)\nFailed: $FAILED_PARTS" "$COMBINED_LOG"
fi
