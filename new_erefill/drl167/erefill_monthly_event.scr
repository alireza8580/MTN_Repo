#!/bin/bash
#===============================================================================
# EREFILL Gather Stats - Monthly (10th of month at 2AM)
# Server: Drl167
# PDB: EREFILL_EVENT (12 tables)
# granularity => 'GLOBAL' for full structure stats
# Cron: 0 2 10 * *
#===============================================================================

# Source configuration
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source ${SCRIPT_DIR}/erefill_config.env

# Cleanup logs older than 30 days
cleanup_old_logs

log_message "Monthly Gather Stats (EVENT) Started"

LOG_FILE="${LOG_DIR}/monthly_event.log"

#------------------------------------------------------------------------------
# EREFILL_EVENT PDB - Monthly GLOBAL stats
#------------------------------------------------------------------------------
export ORACLE_PDB_SID=${PDB_EREFILL_EVENT}
${ORACLE_HOME}/bin/sqlplus -S / as sysdba @${SCRIPT_DIR}/erefill_monthly_gen_event.sql $SCRIPT_DIR 2>&1 | tee ${LOG_FILE}
SQL_STATUS=${PIPESTATUS[0]}

if [ $SQL_STATUS -eq 0 ]; then
    log_message "Monthly Gather Stats (EVENT) Completed Successfully"
    send_success_email "Monthly Gather Stats (EVENT)" "${LOG_FILE}"
else
    log_message "Monthly Gather Stats (EVENT) FAILED"
    send_email "Monthly Gather Stats (EVENT) FAILED" "Gather stats failed at $(date)" "${LOG_FILE}"
fi
