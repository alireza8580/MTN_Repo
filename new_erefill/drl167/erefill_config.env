#!/bin/bash
#==============================================================================
# EREFILL Gather Stats Configuration - Drl167
# This file is sourced by all gather stats scripts
# 
# IMPORTANT: Modify the BASE_DIR and SCRIPT_SUBDIR below to match your setup
#==============================================================================

#------------------------------------------------------------------------------
# PATH CONFIGURATION - Edit these variables to change installation location
#------------------------------------------------------------------------------
BASE_DIR=/oracle/alireza
SCRIPT_SUBDIR=Schedule_ORA_OS_Job/drl167

# Full script directory (derived from above)
export SCRIPT_DIR=${BASE_DIR}/${SCRIPT_SUBDIR}
export LOG_DIR=${SCRIPT_DIR}/logs

#------------------------------------------------------------------------------
# Oracle Environment
#------------------------------------------------------------------------------
export ORACLE_BASE=/oracle
export ORACLE_HOME=/oracle/product/19.25/db_1
export ORACLE_SID=erefill
export PATH=$ORACLE_HOME/bin:$PATH
export LD_LIBRARY_PATH=$ORACLE_HOME/lib:$LD_LIBRARY_PATH

#------------------------------------------------------------------------------
# PDB Names
#------------------------------------------------------------------------------
export PDB_EREFILL_EVENT=erefill_event
export PDB_EREFILL_CORE=erefill_core

#------------------------------------------------------------------------------
# Email Configuration
# Set TEST_MODE=1 to send emails only to test recipient
#------------------------------------------------------------------------------
TEST_MODE=0

MAIL_RECIPIENT_PROD="alireza.aghaja@mtnirancell.ir,isdcdba@mtnirancell.ir,saeidbsupport@mtnirancell.ir"
MAIL_RECIPIENT_TEST="alireza.aghaja@mtnirancell.ir"

if [ "$TEST_MODE" -eq 1 ]; then
    export MAIL_RECIPIENTS="${MAIL_RECIPIENT_TEST}"
else
    export MAIL_RECIPIENTS="${MAIL_RECIPIENT_PROD}"
fi

export MAIL_SUBJECT_PREFIX="[EREFILL]"

#------------------------------------------------------------------------------
# Create log directory if not exists
#------------------------------------------------------------------------------
mkdir -p $LOG_DIR

#==============================================================================
# Functions
#==============================================================================

# Function: format_duration
# Usage: format_duration seconds
# Returns: "Xh Ym Zs" or "Ym Zs" or "Zs"
format_duration() {
    local secs=$1
    local hours=$((secs / 3600))
    local mins=$(((secs % 3600) / 60))
    local s=$((secs % 60))
    if [ $hours -gt 0 ]; then
        printf "%dh %dm %ds" $hours $mins $s
    elif [ $mins -gt 0 ]; then
        printf "%dm %ds" $mins $s
    else
        printf "%ds" $s
    fi
}

# Function: cleanup_old_logs
# Removes log files older than 30 days
cleanup_old_logs() {
    find ${LOG_DIR} -name "*.log" -mtime +30 -delete 2>/dev/null
}

# Function: log_message
# Usage: log_message "message"
log_message() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_DIR}/gather_stats.log
}

# Function: send_email
# Usage: send_email "subject" "body" [log_file]
# If log_file is provided, its content will be appended to the email body
send_email() {
    local subject="$1"
    local body="$2"
    local log_file="${3:-}"
    
    if [ -n "$log_file" ] && [ -f "$log_file" ]; then
        # Send body + log content
        {
            echo -e "$body"
            echo ""
            echo "=== Log Output ==="
            cat "$log_file"
        } | mail -s "${MAIL_SUBJECT_PREFIX} ${subject}" ${MAIL_RECIPIENTS}
    else
        echo -e "$body" | mail -s "${MAIL_SUBJECT_PREFIX} ${subject}" ${MAIL_RECIPIENTS}
    fi
}


# Function: send_success_email
# Usage: send_success_email schedule_name log_file
# Sends email with spool file content (commands + elapsed time from SET TIMING ON)
# Subject format: [CDB.PDB] schedule_name - SUCCESS (or [custom_prefix] if provided)
send_success_email() {
    local schedule_name="$1"
    local log_file="$2"
    local custom_prefix="${3:-}"  # Optional: custom prefix for multi-PDB scripts
    
    # Build subject prefix
    local db_prefix
    if [ -n "$custom_prefix" ]; then
        db_prefix="$custom_prefix"
    else
        db_prefix="${ORACLE_SID}.${ORACLE_PDB_SID}"
    fi
    
    # Read spool file content
    local spool_content=""
    if [ -n "$log_file" ] && [ -f "$log_file" ]; then
        spool_content=$(cat "$log_file" 2>/dev/null)
    fi
    
    # Send email with spool content
    echo "$spool_content" | mail -s "[${db_prefix}] ${schedule_name} - SUCCESS" ${MAIL_RECIPIENTS}
}

# Function: run_sql
# Usage: run_sql pdb_name sql_file
run_sql() {
    local pdb_name="$1"
    local sql_file="$2"
    export ORACLE_PDB_SID=$pdb_name
    sqlplus -s / as sysdba @${sql_file}
}
