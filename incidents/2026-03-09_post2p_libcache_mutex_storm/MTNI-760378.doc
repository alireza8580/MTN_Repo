        <tr id="comment-body-1703407"><td bgcolor="#ffffff">
            <p>Graphs Start</p>

<p> <br/>
<span class="image-wrap" style=""><a id="735689_thumb" href="https://icare.mtnirancell.ir/secure/attachment/735689/735689_Psot2p+CPU+usage+is+around+100%25.jpg" title="Psot2p CPU usage is around 100%.jpg" file-preview-type="image" file-preview-id="735689" file-preview-title="Psot2p CPU usage is around 100%.jpg"><img src="https://icare.mtnirancell.ir/secure/thumbnail/735689/_thumb_735689.png" style="border: 0px solid black" role="presentation"/></a></span> <span class="image-wrap" style=""><a id="735690_thumb" href="https://icare.mtnirancell.ir/secure/attachment/735690/735690_DPOS+registration+total+transactions+is+around+0%25.jpg" title="DPOS registration total transactions is around 0%.jpg" file-preview-type="image" file-preview-id="735690" file-preview-title="DPOS registration total transactions is around 0%.jpg"><img src="https://icare.mtnirancell.ir/secure/thumbnail/735690/_thumb_735690.png" style="border: 0px solid black" role="presentation"/></a></span> <span class="image-wrap" style=""><a id="735691_thumb" href="https://icare.mtnirancell.ir/secure/attachment/735691/735691_IVR+Failure+rate+on+MW+is+100%25.jpg" title="IVR Failure rate on MW is 100%.jpg" file-preview-type="image" file-preview-id="735691" file-preview-title="IVR Failure rate on MW is 100%.jpg"><img src="https://icare.mtnirancell.ir/secure/thumbnail/735691/_thumb_735691.png" style="border: 0px solid black" role="presentation"/></a></span></p>
