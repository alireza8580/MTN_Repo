#!/bin/bash
# MySQL Enterprise Backup Script
# Generated by Ansible - mysql_install role
# Host: {{ ansible_hostname }}
# Port: {{ mysql_port }}

# Configuration
PORT={{ mysql_port }}
SQLP_PORT=sqlp6
RETENTION=3
{% if mysql_nfs_backup %}
BASE_DIR={{ mysql_nfs_backup.split(':')[1] }}/{{ ansible_hostname }}
{% else %}
BASE_DIR=/data/backup/{{ ansible_hostname }}
{% endif %}
BACKUP_DIR=$BASE_DIR/full
LOG_DIR={{ mysql_log_dir }}
DATE=$(date +%Y%m%d_%H%M%S)
HOSTNAME=$(hostname)

# Create backup directory
mkdir -p $BACKUP_DIR

# Get day number (0=Sunday, 6=Saturday)
dn=$(date +%w)

# Tape backup on Saturday
if [[ $dn -eq 6 ]]; then
    RETENTION=1
    TAPE=tape
fi

# Full backup
echo "Starting backup at $(date)" >> $LOG_DIR/backup.log
{{ mysql_meb_path }}/mysqlbackup \
    --user=root \
    --socket={{ mysql_socket }} \
    --backup-dir=$BACKUP_DIR/$DATE \
    --with-timestamp \
    backup-and-apply-log >> $LOG_DIR/backup.log 2>&1

RESULT=$?

if [ $RESULT -eq 0 ]; then
    echo "Backup completed successfully at $(date)" >> $LOG_DIR/backup.log
    
    # Cleanup old backups
    find $BACKUP_DIR -maxdepth 1 -type d -mtime +$RETENTION -exec rm -rf {} \;
else
    echo "Backup FAILED at $(date)" >> $LOG_DIR/backup.log
    # Send alert
    echo "MySQL backup failed on $HOSTNAME" | mailx -s "MySQL Backup FAILED - $HOSTNAME" isdcdba@mtnirancell.ir
fi

exit $RESULT
