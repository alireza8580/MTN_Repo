# MySQL 8.4 Configuration File
# Generated by Ansible - mysql_install role
# DO NOT EDIT MANUALLY

[mysqld@{{ mysql_port }}]

#=============================================================================
# DBA Standard Configuration
#=============================================================================

datadir={{ mysql_data_dir }}
tmpdir={{ mysql_tmp_dir }}
socket={{ mysql_socket }}
log_error={{ mysql_log_dir }}/mysqld.log
pid_file={{ mysql_pid_dir }}/mysqld.pid

# Server identification
server_id={{ mysql_server_id }}

# Binary logging
log_bin={{ mysql_binlog_dir }}/{{ ansible_hostname }}-bin
relay_log={{ mysql_binlog_dir }}/{{ ansible_hostname }}-relay-bin
log_bin_index={{ mysql_data_dir }}/{{ ansible_hostname }}-bin.index
relay_log_index={{ mysql_data_dir }}/{{ ansible_hostname }}-relay-bin.index
binlog_expire_logs_seconds={{ mysql_binlog_expire_seconds }}
max_binlog_size={{ mysql_max_binlog_size }}
binlog_format={{ mysql_binlog_format }}
sync_binlog={{ mysql_sync_binlog }}

# GTID
gtid_mode={{ mysql_gtid_mode }}
enforce_gtid_consistency={{ mysql_enforce_gtid_consistency }}

# InnoDB settings
innodb_flush_log_at_trx_commit=1
innodb_temp_data_file_path=ibtmp1:12M:autoextend:max:{{ mysql_innodb_temp_max_size }}
{% if mysql_innodb_log_file_size != 'auto' %}
innodb_log_file_size={{ mysql_innodb_log_file_size }}
{% endif %}
innodb_file_per_table=1
innodb_default_row_format=DYNAMIC

# Storage engines
disabled_storage_engines="{{ mysql_disabled_storage_engines }}"

# Slow query log
slow_query_log={{ mysql_slow_query_log }}
slow_query_log_file={{ mysql_log_dir }}/mysql-slow.log
long_query_time={{ mysql_long_query_time }}

# Security
sql_require_primary_key={{ mysql_sql_require_primary_key }}

#=============================================================================
# SDS Configuration (Application-specific)
#=============================================================================

character_set_server={{ mysql_character_set }}
collation_server={{ mysql_collation }}
key_buffer_size={{ mysql_key_buffer_size }}
max_allowed_packet={{ mysql_max_allowed_packet }}
table_open_cache={{ mysql_table_open_cache }}
connect_timeout={{ mysql_connect_timeout }}
max_connections={{ mysql_max_connections }}
tmp_table_size={{ mysql_tmp_table_size }}

#=============================================================================
# Security Configuration (CIS)
#=============================================================================

# CIS 2.7, 7.4 - Password lifetime
default_password_lifetime={{ mysql_default_password_lifetime }}

# CIS 2.8 - Password reuse
password_history={{ mysql_password_history }}
password_reuse_interval={{ mysql_password_reuse_interval }}

#=============================================================================
# Audit Configuration
#=============================================================================

# Audit plugin (Enterprise only)
plugin-load-add=audit_log.so
audit_log_file={{ mysql_audit_dir }}/audit.log
audit_log_format=JSON
audit_log_rotate_on_size=104857600
audit_log_policy=LOGINS

[client]
socket={{ mysql_socket }}
