# .bash_profile for MySQL user
# Generated by Ansible - mysql_install role

# Get the aliases and functions
if [ -f ~/.bashrc ]; then
    . ~/.bashrc
fi

# Environment
export PS1="[\u@\h \W]$ "
export PATH=$PATH:/usr/bin
export PATH=$HOME/bin:$PATH:{{ mysql_meb_path }}

# Working directory
cd $HOME/dba_dir/sql

# Aliases for MySQL {{ mysql_port }}
alias sqlp6='mysql --login-path=sqlp6'
alias stop06="sudo /bin/systemctl stop mysqld@{{ mysql_port }}"
alias start06="sudo /bin/systemctl start mysqld@{{ mysql_port }}"
alias restart06="sudo /bin/systemctl restart mysqld@{{ mysql_port }}"
alias status06="sudo /bin/systemctl status mysqld@{{ mysql_port }}"

# Useful functions
mdc() {
    mysql --login-path=sqlp6 "$@"
}

# Check MySQL status on login
echo "MySQL {{ mysql_port }} Status:"
systemctl is-active mysqld@{{ mysql_port }} 2>/dev/null || echo "Service not running"
